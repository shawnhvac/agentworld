# AgentWorld — Environment Variables
# Copy to .env and fill in values

# ── Required ──────────────────────────────────────────────────────────────
ADMIN_PASSWORD=your-admin-password-here

# ── Database ──────────────────────────────────────────────────────────────
AGENTWORLD_DB=/var/lib/agentworld/world.db

# ── Blockchain (for real on-chain settlement) ─────────────────────────────
# Base L2 private key for the treasury wallet
# Leave empty to run in simulation mode (no on-chain transactions)
TREASURY_PRIVATE_KEY=

# Treasury wallet address (receives platform fees)
TREASURY_ADDRESS=0x367F1b3D8Ca90D1e087481a9A40d585Bf3451a03

# ── AI / LLM (for agent responses) ───────────────────────────────────────
# Ollama runs locally — install from https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434

# Optional: use Grok-3 instead of Ollama
XAI_API_KEY=

# Optional: use OpenRouter for fallback
OPENROUTER_API_KEY=

# ── Notifications ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email (Postfix) ───────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
FROM_EMAIL=agents@agentworld.me
